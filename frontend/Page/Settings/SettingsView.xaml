<UserControl
    x:Class="ClimaPulse.Desktop.Page.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ClimaPulse.Desktop.Controls"
    Background="#F5F8FA">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Margin="28">

            <TextBlock
                FontSize="24"
                FontWeight="SemiBold"
                Foreground="#1F2933"
                Text="Settings" />

            <TextBlock
                Margin="0,5,0,18"
                FontSize="12"
                Foreground="#65737E"
                Text="Saved on this PC for the active profile." />

            <controls:Banner
                x:Name="SavedBanner"
                Margin="0,0,0,14"
                Kind="Success"
                Message=""
                Visibility="Collapsed" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border
                        Padding="18"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1F2933"
                                Text="Display" />

                            <TextBlock
                                Margin="0,16,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="Temperature unit" />

                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <RadioButton
                                    x:Name="CelsiusRadio"
                                    Content="°C"
                                    GroupName="Unit"
                                    IsChecked="True" />

                                <RadioButton
                                    x:Name="FahrenheitRadio"
                                    Margin="18,0,0,0"
                                    Content="°F"
                                    GroupName="Unit" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="10"
                                Foreground="#82919C"
                                Text="Data remains stored in Celsius. This changes only what you see."
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,18,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="Theme" />

                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                <Button Content="Light" IsEnabled="False" />

                                <Button
                                    Margin="8,0,0,0"
                                    Content="Dark"
                                    IsEnabled="False" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="10"
                                Foreground="#82919C"
                                Text="Light theme is used in version 1. Dark theme is planned for a later version."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,14,0,0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1F2933"
                                Text="Alerts" />

                            <TextBlock
                                Margin="0,15,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="Alert threshold" />

                            <TextBox
                                Margin="0,7,0,0"
                                IsReadOnly="True"
                                Opacity="0.6"
                                Text="2.0" />

                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="10"
                                Foreground="#82919C"
                                Text="Thresholds are currently changed for each city from its City Detail page."
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border
                        Padding="18"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1F2933"
                                Text="Profile" />

                            <TextBlock
                                Margin="0,16,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Text="Display name" />

                            <TextBox
                                x:Name="DisplayNameTextBox"
                                Margin="0,7,0,0"
                                Padding="8,5"
                                MaxLength="50"
                                TextChanged="DisplayNameTextBox_TextChanged" />

                            <TextBlock
                                x:Name="NameErrorText"
                                Margin="0,5,0,0"
                                FontSize="10"
                                Foreground="#B42318"
                                Visibility="Collapsed" />

                            <TextBlock
                                Margin="0,7,0,0"
                                FontSize="10"
                                Foreground="#82919C"
                                Text="1 to 50 characters." />

                            <Button
                                Margin="0,14,0,0"
                                Padding="0"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="SwitchProfileButton_Click"
                                Content="Switch profile"
                                Foreground="#07566B" />
                        </StackPanel>
                    </Border>

                    <Border
                        Margin="0,14,0,0"
                        Padding="18"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="8">

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#1F2933"
                                Text="Data" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontSize="11"
                                Foreground="#65737E"
                                Text="Baselines use 30 years of daily weather history for each city."
                                TextWrapping="Wrap" />

                            <TextBlock
                                x:Name="CityCountText"
                                Margin="0,12,0,0"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#1F2933"
                                Text="Loading city count…" />

                            <TextBlock
                                Margin="0,14,0,0"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#1F2933"
                                Text="Refresh baseline for" />

                            <ComboBox
                                x:Name="BaselineCityComboBox"
                                Margin="0,7,0,0"
                                DisplayMemberPath="City.Name"
                                SelectedValuePath="City.Id"
                                SelectionChanged="BaselineCityComboBox_SelectionChanged" />

                            <TextBlock
                                x:Name="NoCitiesText"
                                Margin="0,7,0,0"
                                FontSize="10"
                                Foreground="#82919C"
                                Text="Add a city before refreshing its climate baseline."
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <Button
                                x:Name="RefreshBaselinesButton"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="RefreshBaselinesButton_Click"
                                Content="Refresh selected baseline"
                                IsEnabled="False"
                                ToolTip="Recalculate the selected city’s 30-year climate baseline." />

                            <StackPanel
                                x:Name="BaselineProgressPanel"
                                Margin="0,12,0,0"
                                Visibility="Collapsed">

                                <TextBlock
                                    x:Name="BaselineProgressText"
                                    FontSize="11"
                                    Foreground="#07566B"
                                    TextWrapping="Wrap" />

                                <ProgressBar
                                    x:Name="BaselineProgressBar"
                                    Height="7"
                                    Margin="0,6,0,0"
                                    Maximum="100"
                                    Value="0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,18,0,0" Orientation="Horizontal">
                <Button
                    x:Name="SaveButton"
                    Padding="14,8"
                    Background="#07566B"
                    BorderThickness="0"
                    Click="SaveButton_Click"
                    Content="Save changes"
                    Foreground="White" />

                <Button
                    Margin="10,0,0,0"
                    Padding="14,8"
                    Click="CancelButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
