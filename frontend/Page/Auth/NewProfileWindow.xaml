<Window
    x:Class="ClimaPulse.Desktop.Page.Auth.NewProfileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="New profile"
    Width="480"
    Height="350"
    Background="#F5F8FA"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="28">
        <Border
            Padding="26"
            Background="White"
            BorderBrush="#D9E2E8"
            BorderThickness="1"
            CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#1F2933"
                    Text="New profile" />

                <TextBlock
                    Grid.Row="1"
                    Margin="0,10,0,20"
                    FontSize="13"
                    Foreground="#65737E"
                    Text="Profiles keep their cities and settings on this PC. There is no password."
                    TextWrapping="Wrap" />

                <StackPanel Grid.Row="2">
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#1F2933"
                        Text="Your name" />

                    <TextBox
                        x:Name="NameTextBox"
                        Margin="0,7,0,0"
                        Padding="10,8"
                        FontSize="14"
                        MaxLength="50"
                        TextChanged="NameTextBox_TextChanged" />

                    <TextBlock
                        x:Name="HintText"
                        Margin="0,6,0,0"
                        FontSize="11"
                        Foreground="#65737E"
                        Text="Shown in the profile picker. 1 to 50 characters." />

                    <TextBlock
                        x:Name="ErrorText"
                        Margin="0,6,0,0"
                        FontSize="11"
                        Foreground="#B42318"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>

                <StackPanel
                    Grid.Row="5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Width="86"
                        Margin="0,0,10,0"
                        Click="CancelButton_Click"
                        Content="Cancel"
                        IsCancel="True" />

                    <Button
                        x:Name="CreateButton"
                        Width="118"
                        Background="#07566B"
                        BorderThickness="0"
                        Click="CreateButton_Click"
                        Content="Create profile"
                        Foreground="White"
                        IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
