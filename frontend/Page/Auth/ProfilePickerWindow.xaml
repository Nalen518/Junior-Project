<Window
    x:Class="ClimaPulse.Desktop.Page.Auth.ProfilePickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ClimaPulse.Desktop.Page.Auth"
    xmlns:ui="clr-namespace:ClimaPulse.Desktop.Ui"
    Title="ClimaPulse"
    Width="620"
    Height="720"
    MinWidth="500"
    MinHeight="620"
    Background="{StaticResource AppBackgroundBrush}"
    ResizeMode="CanResize"
    SnapsToDevicePixels="True"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Window.Resources>
        <local:InitialConverter x:Key="InitialConverter" />

        <!--  Profile Card Item Style  -->
        <Style x:Key="ProfileCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Card"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource BrandTintBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BrandPrimaryBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Dashed "New Profile" Button Style  -->
        <Style x:Key="DashedActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="62" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border
                                x:Name="FillBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10" />
                            <Rectangle
                                x:Name="DashBorder"
                                Fill="Transparent"
                                RadiusX="10"
                                RadiusY="10"
                                Stroke="{StaticResource BorderDashedBrush}"
                                StrokeDashArray="4 3"
                                StrokeThickness="1.2" />
                            <ContentPresenter
                                Margin="14,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FillBorder" Property="Background" Value="{StaticResource BrandTintBrush}" />
                                <Setter TargetName="DashBorder" Property="Stroke" Value="{StaticResource BrandPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!--  Brand Header (Outside Card)  -->
            <StackPanel Margin="0,0,0,26" HorizontalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="{StaticResource BrandPrimaryBrush}"
                    Text="ClimaPulse" />
                <TextBlock
                    Margin="0,8,0,0"
                    FontSize="12.5"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="See how unusual today's weather is, compared with 30 years of history."
                    TextAlignment="Center" />
            </StackPanel>

            <!--  Main White Card  -->
            <Grid Width="430">
                <!--  Shadow Layer (Sibling, no children inside)  -->
                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="14">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="24"
                            Direction="270"
                            Opacity="0.06"
                            ShadowDepth="4"
                            Color="#0F172A" />
                    </Border.Effect>
                </Border>

                <!--  Crisp Content Layer (No Effect applied)  -->
                <Border
                    Padding="24,24,24,22"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Card Title  -->
                        <TextBlock
                            Grid.Row="0"
                            Margin="0,0,0,16"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Who's using ClimaPulse?" />

                        <!--  Profile List  -->
                        <Grid Grid.Row="1" MaxHeight="300">
                            <ListBox
                                x:Name="ProfilesList"
                                ui:SmoothScrollBehavior.IsEnabled="True"
                                Background="Transparent"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource ProfileCard}"
                                ScrollViewer.CanContentScroll="False"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="ProfilesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Avatar Circle (Inverts on Selection)  -->
                                            <Border
                                                Width="36"
                                                Height="36"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="18">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource AvatarTintBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrandPrimaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>

                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="Bold"
                                                    Text="{Binding DisplayName, Converter={StaticResource InitialConverter}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrandPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="Foreground" Value="White" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!--  Profile Name & Subtitle  -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    Text="{Binding DisplayName}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11.5"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="Local profile" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock
                                x:Name="EmptyStateText"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="No profiles yet. Create one to begin."
                                Visibility="Collapsed" />
                        </Grid>

                        <!--  Dashed New Profile Button  -->
                        <Button
                            Grid.Row="2"
                            Margin="0,2,0,0"
                            Click="NewProfileButton_Click"
                            Style="{StaticResource DashedActionButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    Width="36"
                                    Height="36"
                                    Margin="0,0,10,0"
                                    Background="{StaticResource AvatarTintBrush}"
                                    CornerRadius="18">
                                    <TextBlock
                                        Margin="0,-2,0,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        FontWeight="Normal"
                                        Foreground="{StaticResource BrandPrimaryBrush}"
                                        Text="+" />
                                </Border>
                                <TextBlock VerticalAlignment="Center" Text="New profile" />
                            </StackPanel>
                        </Button>

                        <!--  Continue Button  -->
                        <Button
                            x:Name="ContinueButton"
                            Grid.Row="4"
                            Click="ContinueButton_Click"
                            Content="Continue"
                            IsDefault="True"
                            IsEnabled="False"
                            Style="{StaticResource PrimaryButtonStyle}" />

                        <!--  Footer Note  -->
                        <TextBlock
                            Grid.Row="6"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="No password. Profiles keep cities and settings on this PC only."
                            TextAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
