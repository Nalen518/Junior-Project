<Window
    x:Class="ClimaPulse.Desktop.Page.Auth.FirstCityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ClimaPulse.Desktop.Controls"
    Title="Choose your first city"
    Width="620"
    Height="700"
    MinWidth="520"
    MinHeight="600"
    Background="#F5F8FA"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="CityResultCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D9E2E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Card"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="#E4F3F7" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#07566B" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#07566B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border
            Width="480"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="#D9E2E8"
            BorderThickness="1"
            CornerRadius="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="#07566B"
                        Text="Choose your first city" />

                    <TextBlock
                        Margin="0,8,0,0"
                        FontSize="13"
                        Foreground="#65737E"
                        Text="{Binding WelcomeText}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchTextBox"
                        Padding="10,8"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                        KeyDown="SearchTextBox_KeyDown" />

                    <Button
                        x:Name="SearchButton"
                        Grid.Column="2"
                        Width="95"
                        Background="#07566B"
                        BorderThickness="0"
                        Click="SearchButton_Click"
                        Content="Search"
                        Foreground="White" />
                </Grid>

                <Grid Grid.Row="5">
                    <ListBox
                        x:Name="ResultsList"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource CityResultCard}"
                        SelectionChanged="ResultsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="#1F2933"
                                        Text="{Binding Name}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="12"
                                        Foreground="#65737E">
                                        <Run Text="{Binding AdminRegion}" />
                                        <Run Text=", " />
                                        <Run Text="{Binding CountryCode}" />
                                    </TextBlock>

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="#82919C">
                                        <Run Text="Latitude: " />
                                        <Run Text="{Binding Latitude, StringFormat={}{0:F2}}" />
                                        <Run Text="  •  Longitude: " />
                                        <Run Text="{Binding Longitude, StringFormat={}{0:F2}}" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock
                        x:Name="StatusText"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#65737E"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />

                    <StackPanel
                        x:Name="ImportOverlay"
                        Background="White"
                        Visibility="Collapsed">
                        <controls:BaselineImportPanel x:Name="BaselineImport" />

                        <Button
                            Margin="0,12,0,0"
                            HorizontalAlignment="Left"
                            Click="ContinueButton_Click"
                            Content="Continue" />
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="ErrorText"
                    Grid.Row="7"
                    FontSize="12"
                    Foreground="#B42318"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
                <Button
                    x:Name="AddCityButton"
                    Grid.Row="8"
                    Margin="0,12,0,0"
                    Background="#07566B"
                    BorderThickness="0"
                    Click="AddCityButton_Click"
                    Content="Add selected city"
                    Foreground="White"
                    IsEnabled="False" />
            </Grid>
        </Border>
    </Grid>
</Window>
