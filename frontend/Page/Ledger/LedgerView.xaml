<UserControl
    x:Class="ClimaPulse.Desktop.Page.LedgerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:ClimaPulse.Desktop.Controls"
    Background="#F5F8FA">

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="DrawerColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock
                    FontSize="24"
                    FontWeight="SemiBold"
                    Foreground="#1F2933"
                    Text="Anomaly Ledger" />

                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="12"
                    Foreground="#65737E"
                    Text="Every anomaly episode: when it started, its peak and when it ended. Newest first." />
            </StackPanel>

            <controls:Banner
                x:Name="MessageBanner"
                Grid.Row="2"
                Kind="Info"
                Message=""
                Visibility="Collapsed" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <!--  Sized to fit the 1024 x 640 minimum window (UI-1).  -->
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontSize="10" Text="City" />
                    <ComboBox
                        x:Name="CityFilter"
                        Margin="0,4,0,0"
                        DisplayMemberPath="Name"
                        SelectedValuePath="Id"
                        SelectionChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock FontSize="10" Text="Metric" />
                    <ComboBox
                        x:Name="MetricFilter"
                        Margin="0,4,0,0"
                        SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All metrics" IsSelected="True" />
                        <ComboBoxItem Content="Temperature" />
                        <ComboBoxItem Content="Precipitation" />
                        <ComboBoxItem Content="Wind speed" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock FontSize="10" Text="Tier" />
                    <ComboBox
                        x:Name="TierFilter"
                        Margin="0,4,0,0"
                        SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All tiers" IsSelected="True" />
                        <ComboBoxItem Content="Watch" />
                        <ComboBoxItem Content="Warning" />
                        <ComboBoxItem Content="Extreme" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6">
                    <TextBlock FontSize="10" Text="Status" />
                    <ComboBox
                        x:Name="StatusFilter"
                        Margin="0,4,0,0"
                        SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All" IsSelected="True" />
                        <ComboBoxItem Content="Active" />
                        <ComboBoxItem Content="Closed" />
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="8">
                    <TextBlock FontSize="10" Text="Date range" />
                    <ComboBox
                        x:Name="DateFilter"
                        Margin="0,4,0,0"
                        SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All time" />
                        <ComboBoxItem Content="Last 90 days" IsSelected="True" />
                    </ComboBox>
                </StackPanel>

                <Button
                    Grid.Column="10"
                    Margin="8,17,0,0"
                    Click="ExportCsvButton_Click"
                    Content="Export CSV" />

                <Button
                    Grid.Column="11"
                    Margin="8,17,0,0"
                    Click="ExportJsonButton_Click"
                    Content="Export JSON" />
            </Grid>

            <Grid Grid.Row="6">
                <DataGrid
                    x:Name="EventsGrid"
                    AutoGenerateColumns="False"
                    BorderBrush="#D9E2E8"
                    BorderThickness="1"
                    CanUserAddRows="False"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionChanged="EventsGrid_SelectionChanged"
                    SelectionMode="Single">

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="100" Header="Tier">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <controls:TierBadge VerticalAlignment="Center" Tier="{Binding Tier}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn
                            Width="*"
                            MinWidth="100"
                            Binding="{Binding City}"
                            Header="City" />

                        <DataGridTextColumn
                            Width="105"
                            Binding="{Binding Metric}"
                            Header="Metric" />

                        <DataGridTextColumn
                            Width="115"
                            Binding="{Binding Started}"
                            Header="Started" />

                        <DataGridTextColumn
                            Width="115"
                            Binding="{Binding Ended}"
                            Header="Ended" />

                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Peak}"
                            Header="Peak" />

                        <DataGridTextColumn
                            Width="65"
                            Binding="{Binding PeakZ}"
                            Header="Peak z" />

                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Status}"
                            Header="Status" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border
                    x:Name="LoadingPanel"
                    Background="#F5F8FA"
                    Visibility="Collapsed">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#65737E"
                        Text="Loading anomaly events…" />
                </Border>

                <Border
                    x:Name="EmptyPanel"
                    Background="White"
                    BorderBrush="#D9E2E8"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#1F2933"
                            Text="No events match these filters" />

                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#65737E"
                            Text="Try a wider date range or clear a filter." />

                        <Button
                            Margin="0,14,0,0"
                            Click="ClearFiltersButton_Click"
                            Content="Clear filters" />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ErrorPanel"
                    Background="White"
                    BorderBrush="#E45A5A"
                    BorderThickness="1"
                    CornerRadius="7"
                    Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#B42318"
                            Text="Couldn't load the ledger" />

                        <TextBlock
                            x:Name="LedgerErrorText"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="#65737E" />

                        <Button
                            Margin="0,14,0,0"
                            Click="RetryButton_Click"
                            Content="Retry" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="7" Margin="0,12,0,0">
                <TextBlock
                    x:Name="PagingSummaryText"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="#65737E" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button
                        x:Name="PreviousButton"
                        Click="PreviousButton_Click"
                        Content="Previous" />

                    <TextBlock
                        x:Name="PageText"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        FontSize="11" />

                    <Button
                        x:Name="NextButton"
                        Click="NextButton_Click"
                        Content="Next" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border
            x:Name="DetailsDrawer"
            Grid.Column="1"
            Background="White"
            BorderBrush="#D9E2E8"
            BorderThickness="1,0,0,0"
            Visibility="Collapsed">

            <Grid Margin="22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="#1F2933"
                        Text="Event details" />

                    <Button
                        Padding="4,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseDrawerButton_Click"
                        Content="×"
                        FontSize="18" />
                </Grid>

                <StackPanel Grid.Row="2">
                    <TextBlock
                        x:Name="DrawerTierText"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#B42318" />

                    <TextBlock
                        x:Name="DrawerCityMetricText"
                        Margin="0,8,0,0"
                        FontSize="13"
                        FontWeight="SemiBold" />

                    <TextBlock
                        x:Name="DrawerDetailsText"
                        Margin="0,18,0,0"
                        FontSize="12"
                        Foreground="#65737E"
                        TextWrapping="Wrap" />

                    <Border
                        Margin="0,20,0,0"
                        Padding="12"
                        Background="#E4F3F7"
                        CornerRadius="6">
                        <TextBlock
                            FontSize="11"
                            Foreground="#335561"
                            Text="The baseline mean and standard deviation are saved with the event, so the historical record does not change if a baseline is recomputed."
                            TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
