<Window
    x:Class="ClimaPulse.Desktop.Page.Dashboard.CityDetail.RemoveCity.RemoveCityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Remove city"
    Width="470"
    Height="270"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Margin="12"
        Padding="24"
        Background="White"
        BorderBrush="#D9E2E8"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock
                    x:Name="TitleText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#1F2933" />

                <Button
                    Padding="4,0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CancelButton_Click"
                    Content="×"
                    FontSize="18"
                    Foreground="#65737E" />
            </Grid>

            <TextBlock
                Grid.Row="2"
                FontSize="12"
                Foreground="#65737E"
                TextWrapping="Wrap">
                <Run x:Name="CityNameText" />
                <Run Text=" will no longer appear on your dashboard and you will stop getting alerts for it." />
                <LineBreak />
                <LineBreak />
                <Run Text="Its past events stay in the Anomaly Ledger, and its saved baseline history remains on this PC." />
            </TextBlock>

            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    Margin="0,0,10,0"
                    Padding="12,7"
                    Click="CancelButton_Click"
                    Content="Cancel"
                    IsCancel="True" />

                <Button
                    x:Name="RemoveButton"
                    Padding="12,7"
                    Background="#07566B"
                    BorderThickness="0"
                    Click="RemoveButton_Click"
                    Foreground="White"
                    IsDefault="True" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
