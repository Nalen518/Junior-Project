<Window
    x:Class="ClimaPulse.Desktop.Page.Dashboard.AddCity.AddCityWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Add a city"
    Width="680"
    Height="520"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border
        Margin="10"
        Padding="24"
        Background="White"
        BorderBrush="#D9E2E8"
        BorderThickness="1"
        CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock
                    FontSize="19"
                    FontWeight="SemiBold"
                    Foreground="#1F2933"
                    Text="Add a city" />

                <Button
                    Padding="4,0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="CancelButton_Click"
                    Content="×"
                    FontSize="18"
                    Foreground="#65737E" />
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="#1F2933"
                    Text="Search for a city" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="SearchTextBox"
                        Padding="10,7"
                        BorderBrush="#07566B"
                        FontSize="13"
                        KeyDown="SearchTextBox_KeyDown" />

                    <Button
                        x:Name="SearchButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Background="#07566B"
                        BorderThickness="0"
                        Click="SearchButton_Click"
                        Content="Search"
                        Foreground="White" />
                </Grid>

                <TextBlock
                    Margin="0,5,0,0"
                    FontSize="10"
                    Foreground="#65737E"
                    Text="Search by name. Results come from Open-Meteo." />
            </StackPanel>

            <TextBlock
                x:Name="ResultCountText"
                Grid.Row="4"
                FontSize="11"
                Foreground="#65737E" />

            <Grid Grid.Row="6">
                <StackPanel x:Name="SearchingPanel" Visibility="Collapsed">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="11"
                        Foreground="#65737E"
                        Text="Searching…" />

                    <Border
                        Height="44"
                        Margin="0,0,0,8"
                        Background="#EEF2F4"
                        CornerRadius="5" />

                    <Border
                        Height="44"
                        Margin="0,0,0,8"
                        Background="#EEF2F4"
                        CornerRadius="5" />

                    <Border
                        Height="44"
                        Background="#EEF2F4"
                        CornerRadius="5" />
                </StackPanel>

                <ListBox
                    x:Name="ResultsList"
                    Background="Transparent"
                    BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="#FFFFFF"
                                BorderBrush="#D9E2E8"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#1F2933"
                                            Text="{Binding Name}" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="10"
                                            Foreground="#65737E">
                                            <Run Text="{Binding AdminRegion}" />
                                            <Run Text=", " />
                                            <Run Text="{Binding CountryCode}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Timezone}" />
                                        </TextBlock>

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="10"
                                            Foreground="#82919C">
                                            <Run Text="Lat " />
                                            <Run Text="{Binding Latitude, StringFormat={}{0:F2}}" />
                                            <Run Text=" · Lon " />
                                            <Run Text="{Binding Longitude, StringFormat={}{0:F2}}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Width="58"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Click="AddResultButton_Click"
                                        Content="Add"
                                        Tag="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border
                    x:Name="NoResultsPanel"
                    Padding="25"
                    Background="White"
                    BorderBrush="#D9E2E8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1F2933"
                            Text="No city found" />

                        <TextBlock
                            Margin="0,7,0,0"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="#65737E"
                            Text="Check the spelling, or try a larger city nearby." />
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ErrorPanel"
                    Padding="25"
                    Background="White"
                    BorderBrush="#D9E2E8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#B42318"
                            Text="Couldn't reach Open-Meteo" />

                        <TextBlock
                            x:Name="ErrorText"
                            Margin="0,7,0,0"
                            FontSize="11"
                            Foreground="#65737E"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <Button
                            Margin="0,12,0,0"
                            Click="SearchButton_Click"
                            Content="Retry" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel
                x:Name="BaselineProgressPanel"
                Grid.Row="7"
                Visibility="Collapsed">

                <TextBlock
                    x:Name="BaselineProgressText"
                    FontSize="11"
                    Foreground="#07566B"
                    TextWrapping="Wrap" />

                <ProgressBar
                    x:Name="BaselineProgressBar"
                    Height="7"
                    Margin="0,6,0,0"
                    Maximum="100"
                    Value="0" />
            </StackPanel>

            <TextBlock
                x:Name="AlreadyAddedText"
                Grid.Row="7"
                FontSize="11"
                Foreground="#B42318"
                Visibility="Collapsed" />

            <Button
                Grid.Row="8"
                HorizontalAlignment="Right"
                Background="Transparent"
                BorderThickness="0"
                Click="CancelButton_Click"
                Content="Cancel"
                Foreground="#07566B" />
        </Grid>
    </Border>
</Window>
