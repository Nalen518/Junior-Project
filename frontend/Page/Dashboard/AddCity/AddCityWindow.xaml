<Window x:Class="ClimaPulse.Desktop.Page.Dashboard.AddCity.AddCityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ClimaPulse.Desktop.Controls"
        Title="Add a city"
        Width="680"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="11,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Padding="24"
            Background="White"
            BorderBrush="#D9E2E8"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="Add a city"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#1F2933" />

                <Button Content="×"
                        FontSize="18"
                        Padding="4,0"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#65737E"
                        HorizontalAlignment="Right"
                        Click="CancelButton_Click" />
            </Grid>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Search for a city"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#1F2933" />

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="82" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchTextBox"
                             Padding="10,7"
                             FontSize="13"
                             BorderBrush="#07566B"
                             KeyDown="SearchTextBox_KeyDown" />

                    <Button Grid.Column="1"
                            x:Name="SearchButton"
                            Margin="8,0,0,0"
                            Content="Search"
                            Background="#07566B"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SearchButton_Click" />
                </Grid>

                <TextBlock Text="Search by name. Results come from Open-Meteo."
                           Margin="0,5,0,0"
                           FontSize="10"
                           Foreground="#65737E" />
            </StackPanel>

            <TextBlock x:Name="ResultCountText"
                       Grid.Row="4"
                       FontSize="11"
                       Foreground="#65737E" />

            <Grid Grid.Row="6">
                <StackPanel x:Name="SearchingPanel"
                            Visibility="Collapsed">
                    <TextBlock Text="Searching…"
                               Margin="0,0,0,8"
                               FontSize="11"
                               Foreground="#65737E" />

                    <Border Height="44"
                            Margin="0,0,0,8"
                            Background="#EEF2F4"
                            CornerRadius="5" />

                    <Border Height="44"
                            Margin="0,0,0,8"
                            Background="#EEF2F4"
                            CornerRadius="5" />

                    <Border Height="44"
                            Background="#EEF2F4"
                            CornerRadius="5" />
                </StackPanel>

                <ListBox x:Name="ResultsList"
                         BorderThickness="0"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="12"
                                    Background="#FFFFFF"
                                    BorderBrush="#D9E2E8"
                                    BorderThickness="1"
                                    CornerRadius="6">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2933" />

                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="#65737E">
                                            <Run Text="{Binding AdminRegion}" />
                                            <Run Text=", " />
                                            <Run Text="{Binding CountryCode}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding Timezone}" />
                                        </TextBlock>

                                        <TextBlock Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="#82919C">
                                            <Run Text="Lat " />
                                            <Run Text="{Binding Latitude, StringFormat={}{0:F2}}" />
                                            <Run Text=" · Lon " />
                                            <Run Text="{Binding Longitude, StringFormat={}{0:F2}}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Width="58"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Content="Add"
                                            Tag="{Binding}"
                                            Click="AddResultButton_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="NoResultsPanel"
                        Padding="25"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="No city found"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F2933"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="Check the spelling, or try a larger city nearby."
                                   Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="#65737E"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border x:Name="ErrorPanel"
                        Padding="25"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="Couldn't reach Open-Meteo"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#B42318"
                                   HorizontalAlignment="Center" />

                        <TextBlock x:Name="ErrorText"
                                   Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="#65737E"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <Button Content="Retry"
                                Margin="0,12,0,0"
                                Click="SearchButton_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="ImportOverlay"
                        Padding="18"
                        Background="White"
                        BorderBrush="#D9E2E8"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                    <StackPanel>
                        <controls:BaselineImportPanel x:Name="BaselineImport" />

                        <!--  Keep: the import goes on after the window closes ("You can keep using the app").  -->
                        <Button Content="Continue"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Left"
                                Click="ContinueButton_Click" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock x:Name="AlreadyAddedText"
                       Grid.Row="7"
                       Foreground="#B42318"
                       FontSize="11"
                       Visibility="Collapsed" />

            <Button Grid.Row="8"
                    Content="Cancel"
                    HorizontalAlignment="Right"
                    BorderThickness="0"
                    Background="Transparent"
                    Foreground="#07566B"
                    Click="CancelButton_Click" />
        </Grid>
    </Border>
</Window>