<Window
    x:Class="ClimaPulse.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ClimaPulse"
    Width="1280"
    Height="800"
    MinWidth="1024"
    MinHeight="640"
    Background="#F5F8FA"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <Window.Resources>
        <Style x:Key="NavigationButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="12,4" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#D9E7EC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#174E5D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#063F4C">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="26,30,26,20">
                    <TextBlock
                        FontSize="25"
                        FontWeight="Bold"
                        Foreground="White"
                        Text="ClimaPulse" />

                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="12"
                        Foreground="#B7D1DA"
                        Text="Climate anomaly monitor" />
                </StackPanel>

                <StackPanel
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    VerticalAlignment="Top">

                    <Button
                        x:Name="DashboardButton"
                        Click="DashboardButton_Click"
                        Content="Dashboard"
                        Style="{StaticResource NavigationButtonStyle}" />

                    <Button
                        x:Name="LedgerButton"
                        Click="LedgerButton_Click"
                        Content="Anomaly Ledger"
                        Style="{StaticResource NavigationButtonStyle}" />

                    <Button
                        x:Name="SettingsButton"
                        Click="SettingsButton_Click"
                        Content="Settings"
                        Style="{StaticResource NavigationButtonStyle}" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="18"
                    Padding="12"
                    Background="#174E5D"
                    CornerRadius="8">
                    <StackPanel>
                        <TextBlock
                            FontSize="10"
                            Foreground="#B7D1DA"
                            Text="CURRENT PROFILE" />

                        <TextBlock
                            x:Name="ProfileNameText"
                            Margin="0,5,0,0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White" />

                        <Button
                            Margin="0,6,0,0"
                            Padding="0"
                            HorizontalAlignment="Left"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="SidebarSwitchProfileButton_Click"
                            Content="Switch profile"
                            Cursor="Hand"
                            FontSize="11"
                            Foreground="#B7D1DA" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="White"
                BorderBrush="#D9E2E8"
                BorderThickness="0,0,0,1">
                <Grid Margin="30,0">
                    <TextBlock
                        x:Name="PageTitleText"
                        VerticalAlignment="Center"
                        FontSize="21"
                        FontWeight="SemiBold"
                        Foreground="#1F2933" />
                </Grid>
            </Border>

            <ContentControl x:Name="PageContent" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>
