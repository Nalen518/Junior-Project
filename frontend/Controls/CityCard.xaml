<UserControl
    x:Class="ClimaPulse.Desktop.Controls.CityCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="clr-namespace:ClimaPulse.Desktop.Controls.Charts"
    xmlns:controls="clr-namespace:ClimaPulse.Desktop.Controls"
    x:Name="Root">

    <Button
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        Click="CityCardButton_Click"
        Cursor="Hand">

        <Border
            Width="255"
            Height="235"
            Padding="15"
            Background="White"
            BorderBrush="#D9E2E8"
            BorderThickness="1"
            CornerRadius="8">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#1F2933"
                        Text="{Binding CityName, ElementName=Root}" />

                    <!--  No tier (not refreshed, not scored, error): no badge, never a fake Normal.  -->
                    <controls:TierBadge HorizontalAlignment="Right" Tier="{Binding Tier, ElementName=Root}">
                        <controls:TierBadge.Style>
                            <Style TargetType="controls:TierBadge">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tier, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:TierBadge.Style>
                    </controls:TierBadge>
                </Grid>

                <TextBlock
                    Grid.Row="1"
                    Margin="0,4,0,0"
                    FontSize="11"
                    Foreground="#65737E"
                    Text="{Binding Location, ElementName=Root}" />

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#1F2933"
                        Text="{Binding PrimaryText, ElementName=Root}" />

                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="11"
                        Foreground="#65737E"
                        Text="{Binding SecondaryText, ElementName=Root}"
                        TextWrapping="Wrap" />

                    <charts:BellCurveChart
                        Height="54"
                        Margin="0,6,0,0"
                        ZScore="{Binding ZScore, ElementName=Root}">
                        <charts:BellCurveChart.Style>
                            <Style TargetType="charts:BellCurveChart">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ZScore, ElementName=Root}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </charts:BellCurveChart.Style>
                    </charts:BellCurveChart>

                    <Button
                        Margin="0,10,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Click="ActionButton_Click"
                        Content="{Binding ActionText, ElementName=Root}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActionText, ElementName=Root}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <TextBlock
                    Grid.Row="3"
                    FontSize="10"
                    Foreground="#82919C"
                    Text="{Binding FooterText, ElementName=Root}" />
            </Grid>
        </Border>
    </Button>
</UserControl>
