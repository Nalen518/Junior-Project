<UserControl
    x:Class="ClimaPulse.Desktop.Controls.BaselineImportPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Border
        Padding="14"
        Background="#E4F3F7"
        BorderBrush="#75B4C8"
        BorderThickness="1"
        CornerRadius="6">

        <StackPanel>
            <TextBlock
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#07566B"
                Text="Downloading 30 years of daily history (1995–2024)" />

            <TextBlock
                x:Name="CityText"
                Margin="0,4,0,0"
                FontSize="11"
                Foreground="#07566B" />

            <ProgressBar
                x:Name="ImportProgress"
                Height="8"
                Margin="0,10,0,0"
                Maximum="100" />

            <TextBlock
                Margin="0,8,0,0"
                FontSize="11"
                Foreground="#65737E"
                Text="You can keep using the app." />

            <TextBlock
                x:Name="ErrorText"
                Margin="0,8,0,0"
                FontSize="11"
                Foreground="#B42318"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
